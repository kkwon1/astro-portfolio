---
interface Props {
  title: string;
  url: string;
  date: string;
  tags?: string[];
}

const { title, url, date, tags = [] } = Astro.props;
const isBookReview = tags.includes("book review");
const isPersonal = tags.includes("personal");

const dateObj = new Date(date);
const formattedDateShort = dateObj.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
});
const formattedDateFull = dateObj.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<div class="flex text-sm justify-between">
  <li class="w-10/12 pr-5">
    <a href={url}>{title}</a>
    {isBookReview && (
      <span class="ml-2 inline-block rounded-full bg-slate-200 px-2 py-0.5 text-xs text-slate-700">
        book review
      </span>
    )}
    {isPersonal && (
      <span class="ml-2 inline-block rounded-full bg-slate-200 px-2 py-0.5 text-xs text-slate-700">
        personal
      </span>
    )}
  </li>
  <p>
    <span class="xl:hidden">{formattedDateShort}</span>
    <span class="hidden xl:inline">{formattedDateFull}</span>
  </p>
</div>
