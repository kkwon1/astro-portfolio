---
import Layout from "../layouts/Layout.astro";

const astroPosts = await Astro.glob("./posts/astronomy/*.md");
const reflectionPosts = await Astro.glob("./posts/reflections/*.md");
const bookPosts = await Astro.glob("./posts/books/**/*.md");
const allPosts = [...astroPosts, ...reflectionPosts, ...bookPosts].sort(
  (a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime()
);
const latestPost = [...allPosts]
  .filter((p) => p.frontmatter.tags?.includes("personal"))
  .sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).getTime() -
      new Date(a.frontmatter.pubDate).getTime()
  )[0];

const latestBook = [...allPosts]
  .filter((p) => p.frontmatter.tags?.includes("book review"))
  .sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).getTime() -
      new Date(a.frontmatter.pubDate).getTime()
  )[0];
---

<Layout title="Kevin Kwon">
  <p>
    Hi, welcome to my personal corner on the web.

    <br />
    <br />
    This is a digital space I've created to share a little bit about myself, some
    technical writeups, deeper personal musings, my hobbies and its artifacts, and
    anything else that I find interesting.

    <br />
    <br />
    I hope you enjoy your time here.
  </p>

  {latestPost && (
    <div class="mt-8 pt-8 border-t border-current/20">
      <p class="text-sm font-bold pb-2">Latest post</p>
      <a href={latestPost.url} class="underline text-sm hover:opacity-80">
        {latestPost.frontmatter.title}
      </a>
      <p class="text-xs pt-1 opacity-80">
        {new Date(latestPost.frontmatter.pubDate).toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        })}
      </p>
    </div>
  )}

  {latestBook && (
    <div class="mt-8 pt-8 border-t border-current/20">
      <p class="text-sm font-bold pb-2">Latest book review</p>
      <a href={latestBook.url} class="underline text-sm hover:opacity-80">
        {latestBook.frontmatter.title}
      </a>
      {latestBook.frontmatter.bookAuthor && (
        <p class="text-xs pt-0.5 opacity-80">
          by {latestBook.frontmatter.bookAuthor}
        </p>
      )}
      <p class="text-xs pt-1 opacity-80">
        {new Date(latestBook.frontmatter.pubDate).toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        })}
      </p>
    </div>
  )}
</Layout>
